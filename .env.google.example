# Public configuration for Google Login V2; merge into the existing runtime environment.
# This file is a template, not automatically loaded by Spring Boot.
FRONTEND_URL=http://localhost:3000
AWS_COGNITO_ALLOWED_REDIRECT_URIS=http://localhost:3000/callback
AWS_COGNITO_REFRESH_MODE=sdk
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Use the same App Client/domain as FE; preserve existing deployment values.
AWS_COGNITO_CLIENT_ID=<your-cognito-app-client-id>
AWS_COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
